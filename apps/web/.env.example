# BFF base URL (server side only, never exposed to the browser)
BFF_URL=http://localhost:4000
# Public origin of this site. Drives canonical URLs, og:url and metadataBase.
SITE_URL=http://localhost:3000
# Must match WEB_REVALIDATE_SECRET in apps/bff/.env
REVALIDATE_SECRET=change-me
# Local only: let next/image load media from the local Strapi (localhost:1337).
# Leave unset in production.
ALLOW_LOCAL_IMAGES=true
