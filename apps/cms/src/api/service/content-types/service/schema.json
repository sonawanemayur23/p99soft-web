    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "short": {
      "type": "string",
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "problem": {
      "type": "text",
      "required": true
    },
    "outcomes": {
      "type": "component",
      "component": "shared.text-item",
      "repeatable": true
    },
    "capabilities": {
      "type": "component",
      "component": "shared.titled-text",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    }
  }
}
