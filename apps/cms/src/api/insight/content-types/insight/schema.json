{
  "kind": "collectionType",
  "collectionName": "insights",
  "info": {
    "singularName": "insight",
    "pluralName": "insights",
    "displayName": "Insight"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "author": {
      "type": "string",
      "required": true,
      "default": "P99soft"
    },
    "readMinutes": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "tags": {
      "type": "json"
    },
    "publishedDate": {
      "type": "date",
      "required": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    }
  }
}
