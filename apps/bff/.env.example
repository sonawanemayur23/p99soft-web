PORT=4000
# Strapi internal URL (server to server) and the public URL used for media links
STRAPI_URL=http://localhost:1337
STRAPI_PUBLIC_URL=http://localhost:1337
# Created by `pnpm seed:cms` (written here automatically). Read + create-lead scope.
STRAPI_TOKEN=
# Shared secret Strapi sends in the webhook header `x-p99-webhook-secret`
STRAPI_WEBHOOK_SECRET=change-me
# Web app revalidation endpoint and its secret
WEB_URL=http://localhost:3000
WEB_REVALIDATE_SECRET=change-me
# Public site origin used for canonical URLs and JSON-LD
SITE_URL=https://p99soft.com
# Cache TTL for CMS reads, in seconds
CACHE_TTL=300
# Comma-separated origins allowed to call the BFF from a browser
CORS_ORIGINS=http://localhost:3000
